<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:psa="http://schemas.microsoft.com/appx/manifest/printsupport/windows10/2"
         IgnorableNamespaces="uap uap10 psa">
  <Identity Name="Miyako.PsaFeasibility" Publisher="CN=PsaFeasibilityDev"
            Version="0.1.1.0" ProcessorArchitecture="x64"/>
  <Properties>
    <DisplayName>PSA feasibility - diagnostic only</DisplayName>
    <PublisherDisplayName>PSA feasibility development</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>
  <Resources><Resource Language="en-us"/></Resources>
  <Applications>
    <Application Id="Diagnostic" Executable="PsaDiagnostic.exe" EntryPoint="PsaDiagnostic.App"
                 uap10:SupportsMultipleInstances="true">
      <uap:VisualElements DisplayName="PSA feasibility - diagnostic only"
          Description="Captures synthetic OXPS evidence. Not a PDF printer."
          BackgroundColor="#203040" Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:SplashScreen Image="Assets\SplashScreen.png"/>
      </uap:VisualElements>
      <Extensions>
        <psa:Extension Category="windows.printSupportVirtualPrinterWorkflow" EntryPoint="PsaDiagnostic.Task">
          <psa:PrintSupportVirtualPrinter DisplayName="PSA Diagnostic OXPS (Save As)"
              PrinterUri="psa-diagnostic:interactive" PreferredInputFormat="application/oxps"
              OutputFileTypes="oxps" PdcFile="Config\DiagnosticPdc.xml"/>
        </psa:Extension>
        <psa:Extension Category="windows.printSupportVirtualPrinterWorkflow" EntryPoint="PsaDiagnostic.Task">
          <psa:PrintSupportVirtualPrinter DisplayName="PSA Diagnostic Capture (no file UI)"
              PrinterUri="psa-diagnostic:automation" PreferredInputFormat="application/oxps"
              PdcFile="Config\DiagnosticPdc.xml"/>
        </psa:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Extensions>
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>PsaTask.dll</Path>
        <ActivatableClass ActivatableClassId="PsaDiagnostic.Task" ThreadingModel="both"/>
      </InProcessServer>
    </Extension>
  </Extensions>
</Package>
