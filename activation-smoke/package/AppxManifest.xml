<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
 xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
 xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
 xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
 xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
 xmlns:psa="http://schemas.microsoft.com/appx/manifest/printsupport/windows10/2"
 IgnorableNamespaces="uap uap10 desktop rescap psa">
 <Identity Name="Miyako.PsaActivationSmoke" Publisher="CN=DesktopPdfPrototypeDev"
  Version="0.1.1.0" ProcessorArchitecture="x64"/>
 <Properties>
  <DisplayName>PSA activation smoke - no PDF</DisplayName>
  <PublisherDisplayName>PSA activation experiment</PublisherDisplayName>
  <Logo>Assets\StoreLogo.png</Logo>
 </Properties>
 <Dependencies>
  <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26100.0"/>
 </Dependencies>
 <Resources><Resource Language="en-us"/></Resources>
 <Applications>
  <Application Id="Printer" Executable="SmokeApp.exe" EntryPoint="PsaActivationSmoke.App"
   uap10:SupportsMultipleInstances="true">
   <uap:VisualElements DisplayName="PSA activation smoke - no PDF" Description="Launch experiment only. No PDF."
    BackgroundColor="#203040" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
    <uap:SplashScreen Image="Assets\SplashScreen.png"/>
   </uap:VisualElements>
   <Extensions>
    <psa:Extension Category="windows.printSupportVirtualPrinterWorkflow" EntryPoint="PsaActivationSmoke.Task">
     <psa:PrintSupportVirtualPrinter DisplayName="ms-resource:QueueDisplayName"
      PrinterUri="psa-activation-smoke:synthetic" PreferredInputFormat="application/oxps" PdcFile="Config\SmokePdc.xml"/>
    </psa:Extension>
    <desktop:Extension Category="windows.fullTrustProcess" Executable="SmokeHost.exe"/>
   </Extensions>
  </Application>
  <Application Id="Observer" Executable="SmokeObserver.exe" EntryPoint="Windows.FullTrustApplication"
   uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
   <uap:VisualElements DisplayName="PSA smoke observer" Description="Synthetic submission and exit observation only."
    BackgroundColor="#203040" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"/>
  </Application>
 </Applications>
 <Extensions>
  <Extension Category="windows.activatableClass.inProcessServer">
   <InProcessServer>
    <Path>SmokeTask.dll</Path>
    <ActivatableClass ActivatableClassId="PsaActivationSmoke.Task" ThreadingModel="both"/>
   </InProcessServer>
  </Extension>
 </Extensions>
 <Capabilities><rescap:Capability Name="runFullTrust"/></Capabilities>
</Package>
