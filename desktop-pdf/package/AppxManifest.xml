<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
 xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
 xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
 xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
 xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
 xmlns:psa="http://schemas.microsoft.com/appx/manifest/printsupport/windows10/2"
 IgnorableNamespaces="uap uap10 desktop rescap psa">
 <Identity Name="Miyako.DesktopPdfIntegration" Publisher="CN=DesktopPdfPrototypeDev"
  Version="0.1.0.0" ProcessorArchitecture="x64"/>
 <Properties>
  <DisplayName>4D PDF Integration - source prototype</DisplayName>
  <PublisherDisplayName>Desktop PDF development</PublisherDisplayName>
  <Logo>Assets\StoreLogo.png</Logo>
 </Properties>
 <Dependencies>
  <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26100.0"/>
 </Dependencies>
 <Resources><Resource Language="en-us"/></Resources>
 <Applications>
  <Application Id="SaveAs" Executable="IntegrationApp.exe" EntryPoint="DesktopPdfIntegration.App"
   uap10:SupportsMultipleInstances="true">
   <uap:VisualElements DisplayName="4D PDF Integration (Save As)" Description="Development PDF printer"
    BackgroundColor="#203040" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
    <uap:SplashScreen Image="Assets\SplashScreen.png"/>
   </uap:VisualElements>
   <Extensions>
    <psa:Extension Category="windows.printSupportVirtualPrinterWorkflow" EntryPoint="DesktopPdfIntegration.Task">
     <psa:PrintSupportVirtualPrinter DisplayName="ms-resource:SaveAsQueue"
      PrinterUri="desktop-pdf:save-as" PreferredInputFormat="application/oxps"
      OutputFileTypes="pdf" PdcFile="Config\IntegrationPdc.xml"/>
    </psa:Extension>
    <desktop:Extension Category="windows.fullTrustProcess" Executable="IntegrationHost.exe"/>
   </Extensions>
  </Application>
  <Application Id="Silent" Executable="IntegrationApp.exe" EntryPoint="DesktopPdfIntegration.App"
   uap10:SupportsMultipleInstances="true">
   <uap:VisualElements DisplayName="4D PDF Integration (Silent)" Description="Explicit registered PDF destination"
    BackgroundColor="#203040" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
    <uap:SplashScreen Image="Assets\SplashScreen.png"/>
   </uap:VisualElements>
   <Extensions>
    <psa:Extension Category="windows.printSupportVirtualPrinterWorkflow" EntryPoint="DesktopPdfIntegration.Task">
     <psa:PrintSupportVirtualPrinter DisplayName="ms-resource:SilentQueue"
      PrinterUri="desktop-pdf:silent" PreferredInputFormat="application/oxps" PdcFile="Config\IntegrationPdc.xml"/>
    </psa:Extension>
    <desktop:Extension Category="windows.fullTrustProcess" Executable="IntegrationHost.exe"/>
   </Extensions>
  </Application>
  <Application Id="Client" Executable="IntegrationClient.exe" EntryPoint="Windows.FullTrustApplication"
   uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
   <uap:VisualElements DisplayName="4D PDF Integration client" Description="Explicit registration, status and cancellation"
    BackgroundColor="#203040" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"/>
  </Application>
 </Applications>
 <Extensions>
  <Extension Category="windows.activatableClass.inProcessServer">
   <InProcessServer>
    <Path>IntegrationTask.dll</Path>
    <ActivatableClass ActivatableClassId="DesktopPdfIntegration.Task" ThreadingModel="both"/>
   </InProcessServer>
  </Extension>
 </Extensions>
 <Capabilities><rescap:Capability Name="runFullTrust"/></Capabilities>
</Package>
